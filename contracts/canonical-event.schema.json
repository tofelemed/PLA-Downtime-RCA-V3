{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proact.local/contracts/canonical-event.schema.json",
  "title": "ProAct canonical ingestion envelope",
  "description": "Versioned envelope every adapter (PI Web API, MQTT, Kafka, future OPC UA/imports) emits into the intake pipeline (spec section 5.1, FND01-FND04, ING01). Logical identity = tenantId + connectionId + sourceObjectId; delivery identity = tenantId + connectionId + messageId. Completed in plan 1.5; the backend validates every envelope against this file (src/intake/envelope/canonical-event.schema.ts is the checked copy).",
  "type": "object",
  "required": [
    "schemaVersion",
    "messageId",
    "tenantId",
    "connectionId",
    "sourceType",
    "sourceObjectId",
    "operation",
    "kind",
    "observedAt",
    "receivedAt",
    "location",
    "quality",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "messageId": {
      "type": "string",
      "minLength": 1,
      "description": "Identifies one delivery (dedupe key with tenantId + connectionId)."
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "description": "Checked against the connector's authenticated binding; never grants access."
    },
    "connectionId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceType": {
      "type": "string",
      "enum": [
        "pi_web_api",
        "mqtt",
        "kafka",
        "opc_ua",
        "rest_import",
        "file_import",
        "db_import",
        "manual"
      ]
    },
    "sourceObjectId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identity of the source object (e.g. PI WebId, topic+device id). Logical identity = tenant + connection + sourceObjectId."
    },
    "sourceRevision": {
      "type": [
        "string",
        "null"
      ],
      "description": "Source version/revision when the source has one; otherwise null and contentHash is used."
    },
    "operation": {
      "type": "string",
      "enum": [
        "observe",
        "correct",
        "retract"
      ],
      "description": "ING01: independent observation, correction of an earlier revision, or retraction (tombstone)."
    },
    "kind": {
      "type": "string",
      "enum": [
        "interval_event",
        "measurement",
        "state",
        "output_event",
        "retraction"
      ]
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Event time at the source (UTC)."
    },
    "receivedAt": {
      "type": "string",
      "format": "date-time",
      "description": "When the connector received it (UTC)."
    },
    "startTime": {
      "type": "string",
      "format": "date-time",
      "description": "Interval kinds only."
    },
    "endTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Null = open interval. Source sentinels (e.g. 9999-12-31) are normalised to null and kept in rawPayload."
    },
    "sourceTimezone": {
      "type": [
        "string",
        "null"
      ],
      "description": "IANA zone if the source supplied local times."
    },
    "location": {
      "type": "object",
      "required": [
        "sourcePath"
      ],
      "additionalProperties": false,
      "properties": {
        "sourcePath": {
          "type": "string",
          "description": "Source asset path or identifier as delivered."
        },
        "sourceElementIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ancestor identifiers for mapping (e.g. AF element WebIds)."
        },
        "unitId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "Assigned by mapping, never guessed by the adapter."
        },
        "assetId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "values": {
      "type": "object",
      "description": "Typed values. For interval events: template name and attributes; for measurements: a single sample.",
      "additionalProperties": false,
      "properties": {
        "templateName": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "number",
                  "string",
                  "boolean",
                  "digital",
                  "duration",
                  "timestamp"
                ]
              },
              "value": {},
              "digital": {
                "type": "object",
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "integer"
                  },
                  "isSystem": {
                    "type": "boolean"
                  }
                }
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "semanticType": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "rate",
                  "counter",
                  "state",
                  "quality",
                  "level",
                  "output_increment",
                  "other",
                  null
                ]
              }
            }
          }
        },
        "sample": {
          "type": "object",
          "required": [
            "signalRef",
            "value"
          ],
          "properties": {
            "signalRef": {
              "type": "string"
            },
            "value": {},
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "semanticType": {
              "type": "string",
              "enum": [
                "rate",
                "counter",
                "state",
                "quality",
                "level",
                "output_increment",
                "other"
              ]
            },
            "sequence": {
              "type": [
                "integer",
                "null"
              ]
            },
            "digital": {
              "type": "object",
              "description": "Enumeration-set (digital state) value as the source delivered it (PI: Name, Value, IsSystem); value is then null. Added in plan 1.7.",
              "required": [
                "name",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "integer"
                },
                "isSystem": {
                  "type": "boolean"
                }
              }
            },
            "summary": {
              "type": "object",
              "description": "Set when the sample is a source summary over [startTime, endTime) instead of a point value (PI Total of a rate signal, PI09). Added in plan 1.7.",
              "required": [
                "summaryType",
                "calculationBasis",
                "timebase"
              ],
              "additionalProperties": false,
              "properties": {
                "summaryType": {
                  "type": "string",
                  "enum": [
                    "Total"
                  ]
                },
                "calculationBasis": {
                  "type": "string",
                  "enum": [
                    "TimeWeighted"
                  ]
                },
                "timebase": {
                  "type": "string",
                  "enum": [
                    "s",
                    "min",
                    "h",
                    "d"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        "state": {
          "type": "object",
          "required": [
            "stateRef",
            "value"
          ],
          "additionalProperties": false,
          "description": "State observations (kind state, plan 1.10).",
          "properties": {
            "stateRef": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "previousValue": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            },
            "sequence": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "output": {
          "type": "object",
          "required": [
            "quantity"
          ],
          "additionalProperties": false,
          "description": "Production output of an output_event (plan 1.7).",
          "properties": {
            "quantity": {
              "type": "number"
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "productRef": {
              "type": [
                "string",
                "null"
              ]
            },
            "good": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "good",
            "uncertain",
            "bad",
            "missing"
          ]
        },
        "sourceFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "degraded": {
          "type": "boolean",
          "description": "e.g. timestamp substituted by receive time (MQ03)."
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "payloadHash",
        "mappingVersion",
        "correlationId"
      ],
      "additionalProperties": false,
      "properties": {
        "rawPayload": {
          "description": "Inline raw payload when <= 1 MiB."
        },
        "rawPayloadRef": {
          "type": [
            "string",
            "null"
          ],
          "description": "Object-store reference when the payload is large (KF04)."
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sourceCursor": {
          "type": [
            "object",
            "null"
          ],
          "description": "Adapter checkpoint context (window, page, offset)."
        },
        "mappingVersion": {
          "type": "integer",
          "minimum": 0
        },
        "correlationId": {
          "type": "string"
        },
        "replayRunId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "Set on replays; the envelope keeps the original messageId and identity so intake links the delivery to the first one."
        }
      }
    },
    "sourceControls": {
      "type": "object",
      "description": "Protocol-specific controls (section 5.1 last row).",
      "additionalProperties": false,
      "properties": {
        "mqtt": {
          "type": "object",
          "properties": {
            "retained": {
              "type": "boolean"
            },
            "duplicate": {
              "type": "boolean"
            },
            "qos": {
              "type": "integer"
            },
            "bootId": {
              "type": [
                "string",
                "null"
              ]
            },
            "sequence": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "kafka": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string"
            },
            "partition": {
              "type": "integer"
            },
            "offset": {
              "type": "integer"
            },
            "key": {
              "type": [
                "string",
                "null"
              ]
            },
            "headers": {
              "type": "object"
            }
          }
        },
        "pi": {
          "type": "object",
          "properties": {
            "webId": {
              "type": "string"
            },
            "lastModified": {
              "type": [
                "string",
                "null"
              ]
            },
            "contentHash": {
              "type": [
                "string",
                "null"
              ]
            },
            "rawEndTime": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "retraction": {
      "type": "object",
      "additionalProperties": false,
      "description": "Details of a retraction (kind retraction / operation retract).",
      "properties": {
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "retractsRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "confirmedDeletion": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "True when the source deletion was confirmed (PI06: completed inventory comparison plus a direct lookup); the source object becomes deleted_confirmed."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "interval_event",
              "output_event"
            ]
          }
        }
      },
      "then": {
        "required": [
          "startTime"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "measurement"
          }
        }
      },
      "then": {
        "required": [
          "values"
        ],
        "properties": {
          "values": {
            "type": "object",
            "required": [
              "sample"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "state"
          }
        }
      },
      "then": {
        "required": [
          "values"
        ],
        "properties": {
          "values": {
            "type": "object",
            "required": [
              "state"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "retraction"
          }
        }
      },
      "then": {
        "properties": {
          "operation": {
            "const": "retract"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "retract"
          }
        }
      },
      "then": {
        "required": [
          "sourceRevision"
        ]
      }
    }
  ]
}
