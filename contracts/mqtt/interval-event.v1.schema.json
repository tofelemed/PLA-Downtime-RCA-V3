{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proact.local/contracts/mqtt/interval-event.v1.schema.json",
  "title": "Pro-Act MQTT interval event v1",
  "description": "One message per event frame change on …/events (OT contract §3.1): creation (open or closed), update (end time set, attribute changed) or deletion. event_id + revision make a message idempotent; end_ts is null while the event is open and never the PI 9999 sentinel.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "revision",
    "operation",
    "ts",
    "seq",
    "boot_id"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339 with explicit offset or Z; source time, never publish time."
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic per publisher session; restarts at 0 with every boot_id."
    },
    "boot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Changes on every publisher (re)start; boot_id + seq is the delivery identity."
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "quality": {
      "description": "PI value flags (good / questionable / substituted / annotated) or a string token of another convention; omit only when the source has no quality concept. Missing is never treated as good.",
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "good": {
              "type": "boolean"
            },
            "questionable": {
              "type": "boolean"
            },
            "substituted": {
              "type": "boolean"
            },
            "annotated": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "Stable for the life of the event: PI Event Frame ID or WebId, or an RFC 9562 UUID."
    },
    "revision": {
      "type": [
        "string",
        "integer"
      ],
      "minLength": 1,
      "maxLength": 64,
      "minimum": 0,
      "description": "Changes on every update: EF LastModified (RFC 3339) or an integer version."
    },
    "operation": {
      "type": "string",
      "enum": [
        "upsert",
        "delete"
      ]
    },
    "template": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "element_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "AF path of the primary referenced element."
    },
    "start_ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC 3339 with explicit offset or Z; source time, never publish time."
    },
    "end_ts": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "pattern": "^[0-8][0-9]{3}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "Null while open; never the PI 9999 sentinel."
    },
    "attributes": {
      "type": "object",
      "description": "EF attribute values by attribute name, exactly as named in the template.",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string",
            "maxLength": 4096
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": [
              "name",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "value": {
                "type": "integer"
              }
            }
          }
        ]
      }
    },
    "attribute_units": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 32
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "upsert"
          }
        }
      },
      "then": {
        "required": [
          "template",
          "element_path",
          "start_ts"
        ]
      }
    }
  ]
}
