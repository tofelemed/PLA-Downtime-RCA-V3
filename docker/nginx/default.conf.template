# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Only ${BACKEND_URL}, ${PI_SERVER} and ${CLIENT_MAX_BODY_SIZE} are environment variables;
# nginx's own $variables are untouched because envsubst only substitutes defined env vars.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Resolve upstreams per request through Docker's embedded DNS, so nginx starts even if the
    # backend container is not up yet and follows IP changes after a backend restart.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend "${BACKEND_URL}";
    set $pi_server "${PI_SERVER}";

    client_max_body_size ${CLIENT_MAX_BODY_SIZE};

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # ---- Backend (NestJS) ------------------------------------------------------------------
    # REST API and Swagger UI, both under the /api prefix
    location /api {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
    }

    # Files uploaded through the API, served statically by the backend
    location /uploads {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Socket.IO: the v1 realtime (/socket.io namespace), scoped v2 realtime (/realtime, plan 3.1) and
    # connectivity (/connectivity namespace) gateways all use this transport path
    location /socket.io {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ---- AVEVA PI Web API (same as the Vite dev proxy for direct browser calls) ------------
    location /piwebapi {
        proxy_pass $pi_server;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_ssl_server_name on;
        proxy_read_timeout 300s;
    }

    # ---- SPA -------------------------------------------------------------------------------
    # Hashed build assets can be cached indefinitely
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Client-side routing: unknown paths fall back to the app shell
    location / {
        try_files $uri $uri/ /index.html;
    }
}
