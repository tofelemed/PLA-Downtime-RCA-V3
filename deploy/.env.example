# Traverse Forge — production environment (TF-PREP-001 §4.7)
# Copied to /opt/traverse-forge/.env by deploy/vm/install.sh on first install (never overwritten).
# Every value below is a placeholder: replace each CHANGE_ME before starting. No real secret belongs in
# this file or in the repository. Generate secrets with:  openssl rand -base64 48 | tr -d '\n/+='

# --- Release ------------------------------------------------------------------------------------------
# Image tag selected by the production compose. Set by load-and-start.sh; never "latest".
FORGE_VERSION=CHANGE_ME
# Host port of the web UI (frontend container listens on 8080)
FORGE_UI_PORT=8095

# --- Database (existing instrumental-postgres container, shared with other systems) --------------------
# Docker network of the database container (external to the traverse-forge compose project)
PG_NETWORK=instrumental-network
DB_HOST=instrumental-postgres
DB_PORT=5432
DB_NAME=traverse_forge
# Application schema; the app sets search_path to it on every connection
DB_SCHEMA=forge
# Existing login role on instrumental-postgres, reused for migrations and runtime (decision 2026-10-26).
# It must own (or be able to create) database traverse_forge and schema forge, and be a member of the
# row-level-security role proact_rls_user (deploy/db/00-create-db-and-roles.sh grants it).
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
# Connections per process (API and worker each hold a pool of this size)
DB_POOL_MAX=10
# TLS to the database: false | true (certificate verified; trust a private CA via NODE_EXTRA_CA_CERTS)
DB_SSL=false
# Statement timeout of the runtime pool, ms
DB_STATEMENT_TIMEOUT_MS=30000
# Migrations are a release step (deploy/db/10-migrate.sh), never at start-up
DB_MIGRATIONS_RUN=false
# Row-level security per request (SET ROLE proact_rls_user + tenant list)
DB_RLS_TENANT_BINDING=true

# --- Authentication ------------------------------------------------------------------------------------
# Access-token signing key, at least 32 characters
JWT_SECRET=CHANGE_ME
# Refresh-token signing key, different from JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_TTL=15m
JWT_REFRESH_EXPIRATION=7d
# Registration only by administrators
AUTH_ALLOW_PUBLIC_REGISTRATION=false

# --- Stored connector credentials (MQTT / PI passwords in the database) --------------------------------
# Key ring "id:secret" (secret at least 16 characters; comma-separated when rotating) and the current id.
# Losing these makes stored connector passwords unreadable: back them up with the database credentials.
CREDENTIAL_ENCRYPTION_KEYS=k1:CHANGE_ME
CREDENTIAL_ENCRYPTION_KEY_ID=k1

# --- HTTP ----------------------------------------------------------------------------------------------
NODE_ENV=production
# API port inside the private network (not published on the host)
PORT=3000
# Only nginx on the private network sits in front of the API (client IPs from X-Forwarded-For)
TRUST_PROXY=loopback, uniquelocal
# Browser origin of the UI, e.g. http://<vm-address>:8095 (only affects direct calls to the API)
CORS_ORIGIN=CHANGE_ME
# Swagger UI at /api (no sign-in): off in production
FORGE_SWAGGER=false
# Hosts the PI / connector clients may reach, comma-separated (empty = unrestricted)
CONNECTOR_EGRESS_ALLOWLIST=
# Prometheus metrics port inside the network; empty = off. Never publish it.
METRICS_PORT=

# --- Plant (reference seed parameters, deploy/db/20-seed-reference.sh) ---------------------------------
# Defaults are the values configured in the development database (TF-PREP-001 §6.2)
FORGE_ORG_CODE=MPC-TRAIN
FORGE_ORG_NAME=Marun
FORGE_PLANT_CODE=HDPE-TRAIN
FORGE_PLANT_NAME=HDPE plant
# IANA time zone of the plant: seed parameter only; at runtime the time zone is the site's own setting
FORGE_PLANT_TIMEZONE=Asia/Tehran

# --- Files ---------------------------------------------------------------------------------------------
# Report export files: private volume shared by API and worker
EXPORT_STORAGE_DIR=/app/storage/exports
EXPORT_TTL_HOURS=168

# --- Retention (worker) --------------------------------------------------------------------------------
# Audit request log and audit trail, days
AUDIT_REQUEST_LOG_RETENTION_DAYS=30
AUDIT_TRAIL_RETENTION_DAYS=30
# Raw observations / signal samples are dropped by monthly partition: left unset (keep) in production
# until a partition-drop path exists for the application role (decision 2026-10-26)
RAW_RETENTION_DAYS=
SAMPLE_RETENTION_DAYS=
RETENTION_BATCH=1000

# --- Frontend nginx ------------------------------------------------------------------------------------
# Upload limit (backend accepts 25 MiB per file)
CLIENT_MAX_BODY_SIZE=26m

# --- Operator scripts (deploy/db, deploy/vm) -----------------------------------------------------------
# Database container the scripts reach with docker exec (psql, pg_dump, pg_restore)
DB_CONTAINER=instrumental-postgres
# Backups kept by backup-forge.sh (newest N database dumps and N uploads archives)
BACKUP_KEEP=14
# Tenant that 30-seed-users.sh adds accounts to
TENANT_CODE=HDPE-TRAIN
# Seconds verify.sh waits for /api/health/ready and the worker health check
VERIFY_TIMEOUT_S=90
# Read from the shell, not from this file (export them in the shell when they differ from the default):
#   FORGE_HOME=/opt/traverse-forge       install folder of every deploy/vm script
#   FORGE_COMPOSE_EXTRA="-f <file>"      extra compose files (the workstation rehearsal adds docker-compose.local.yml)
