# Docker Compose settings. Copy to .env (git-ignored) and adjust.
# Vite also reads the root .env but only exposes VITE_* keys, so nothing here leaks into the app bundle.

# ---- Host ports -------------------------------------------------------------------------
FRONTEND_PORT=8070
BACKEND_PORT=4004
# Bundled Postgres. 5433 because the shared instrumental-postgres container already uses 5432.
POSTGRES_PORT=5433
# Bundled Kafka broker (host listener) and Kafka UI (`docker compose --profile tools up -d kafka-ui`).
# 9092 only clashes with the host's instrumental-kafka-1 container while that cluster is running.
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
# Bundled MQTT broker: MQTT on 1884 and MQTT-over-WebSockets on 8884, because the host's mosquitto owns 1883/8883.
MQTT_PORT=1884
MQTT_WS_PORT=8884
# Authenticated listeners of the same broker (plan 1.8 step 4): password-protected plain MQTT on 1885 and TLS on 8885
# (container 8883; the host's mosquitto owns 8883). Dev-only users proact-test / proact-test-dev (read-only) and
# proact-sim / proact-sim-dev (read-write); CA certificate docker/mosquitto/certs/dev-ca.crt. See docs/DOCKER.md.
MQTT_AUTH_PORT=1885
MQTT_TLS_PORT=8885

# ---- Database ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=proact
# Apply pending TypeORM migrations on backend boot (set false where a release step runs `migration:run`)
DB_MIGRATIONS_RUN=true
# Postgres row-level security: bind each request to its tenant(s) (plan 3.11; owner decision 2026-10-10). Keep true.
DB_RLS_TENANT_BINDING=true
# Database host as seen from the backend container. Default "postgres" is the bundled service;
# docker-compose.external-db.yml switches it to instrumental-postgres.
#DB_HOST=postgres
#DB_PORT=5432

# ---- Messaging --------------------------------------------------------------------------
# Brokers as seen from the backend/worker containers. Defaults are the bundled `kafka`/`mqtt` services;
# docker-compose.shared-infra.yml switches them to the host's instrumental-kafka-1 / mosquitto containers.
#KAFKA_BROKERS=kafka:29092
#MQTT_URL=mqtt://mqtt:1883
# PROCESS_ROLE (api|worker|all) is fixed per service in docker-compose.yml (backend=api, worker=worker), not set here.

# ---- Auth -------------------------------------------------------------------------------
# 32+ random characters. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Signs refresh tokens. Required by docker compose; 32+ random characters, different from JWT_SECRET.
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
# POST /auth/register without a token. Keep false outside local development; create the first admin with
#   docker compose exec backend node dist/scripts/bootstrap-admin.js --email ... --password ...
AUTH_ALLOW_PUBLIC_REGISTRATION=false
# Encrypts PI/connector credentials at rest; falls back to JWT_SECRET when empty
CREDENTIAL_ENCRYPTION_KEY=
# Named key ring for credential rotation (plan 3.11): "id:secret,id2:secret2" (secrets 16+ characters).
# CREDENTIAL_ENCRYPTION_KEY_ID is the key new values are written with. Leave both empty to keep using
# CREDENTIAL_ENCRYPTION_KEY. Rotate with scripts/security/rotate-credentials.ts.
CREDENTIAL_ENCRYPTION_KEYS=
CREDENTIAL_ENCRYPTION_KEY_ID=

# ---- Report exports (plan 2.9) ----------------------------------------------------------
# Hours a completed export stays downloadable (files live on the private `exports` volume)
EXPORT_TTL_HOURS=168

# ---- Optional ---------------------------------------------------------------------------
# Browser origins allowed to call the backend port directly (comma-separated). Not needed for
# the frontend, which talks to the backend through nginx on its own origin.
CORS_ORIGIN=http://localhost:8070
# AVEVA PI Web API that nginx proxies under /piwebapi (mirrors the Vite dev proxy)
PI_SERVER=https://87.107.103.198:7443
# Hosts connectors may call (comma-separated; "*.corp.example" = any subdomain; optional :port).
# Empty = no restriction (development only). Production lists its PI / broker hosts.
CONNECTOR_EGRESS_ALLOWLIST=
# API base URL baked into the frontend image. Leave unset ("/api" = same origin).
# Do NOT set it here unless you want it: Vite would also apply it to `npm run dev`, where there is no /api proxy.
#VITE_API_BASE_URL=/api
