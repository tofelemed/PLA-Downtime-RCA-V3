  "item": [
    {
      "name": "OPC UA Connections",
      "item": [
        {
          "name": "Create OPC UA Connection",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test OPC UA Server\",\n  \"endpoint\": \"opc.tcp://localhost:4840\",\n  \"securityMode\": \"None\",\n  \"securityPolicy\": \"None\",\n  \"username\": \"testuser\",\n  \"password\": \"testpass\",\n  \"timeoutMs\": 30000,\n  \"sessionTimeoutMs\": 60000,\n  \"keepAliveMs\": 10000,\n  \"maxMessageSize\": 65536,\n  \"pollingIntervalMs\": 1000,\n  \"subscriptionSize\": 1000,\n  \"enabled\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/opcua/connections",
              "host": ["{{baseUrl}}"],
              "path": ["opcua", "connections"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('opcuaConnectionId', response.data.id);",
                  "    console.log('OPC UA Connection ID saved:', response.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All OPC UA Connections",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/opcua/connections",
              "host": ["{{baseUrl}}"],
              "path": ["opcua", "connections"]
            }
          }
        },
        {
          "name": "Get OPC UA Connection by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/opcua/connections/{{opcuaConnectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["opcua", "connections", "{{opcuaConnectionId}}"]
            }
          }
        },
        {
          "name": "Update OPC UA Connection",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated OPC UA Server\",\n  \"pollingIntervalMs\": 2000,\n  \"enabled\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/opcua/connections/{{opcuaConnectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["opcua", "connections", "{{opcuaConnectionId}}"]
            }
          }
        },
        {
          "name": "Test OPC UA Connection",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/opcua/connections/{{opcuaConnectionId}}/test",
              "host": ["{{baseUrl}}"],
              "path": ["opcua", "connections", "{{opcuaConnectionId}}", "test"]
            }
          }
        },
        {
          "name": "Delete OPC UA Connection",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/opcua/connections/{{opcuaConnectionId}}",
