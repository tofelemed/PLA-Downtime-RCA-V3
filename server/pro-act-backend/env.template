# =============================================
# ProAct Backend Environment Configuration
# =============================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to version control

# =============================================
# DATABASE CONFIGURATION (MS SQL Server)
# =============================================
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=YourStrongPassword123!
DB_NAME=ProActDB

# =============================================
# APPLICATION CONFIGURATION
# =============================================
PORT=3000
NODE_ENV=development

# =============================================
# JWT AUTHENTICATION
# =============================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-this-in-production-abc123
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your-refresh-token-secret-different-from-jwt-secret-xyz789
JWT_REFRESH_EXPIRATION=7d

# =============================================
# PASSWORD SECURITY
# =============================================
BCRYPT_ROUNDS=10

# AES-256-GCM key for encrypting PI and connector credentials at rest
# Use a unique 32+ character secret in production (falls back to JWT_SECRET if unset)
CREDENTIAL_ENCRYPTION_KEY=your-credential-encryption-key-minimum-32-characters

# =============================================
# CORS CONFIGURATION
# =============================================
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# =============================================
# SWAGGER/API DOCUMENTATION
# =============================================
SWAGGER_ENABLED=true
SWAGGER_PATH=api

# =============================================
# FILE UPLOAD
# =============================================
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# =============================================
# REPORT EXPORTS (plan 2.9)
# =============================================
# Private directory for export files, shared by the API and the worker. Never under ./uploads
# (served publicly); the service refuses such a path.
EXPORT_STORAGE_DIR=./storage/exports
# Hours a completed export stays downloadable; the worker purges the file afterwards
EXPORT_TTL_HOURS=168
# Upper bounds of one export request (period revisions, window length)
EXPORT_MAX_SOURCES=50000
EXPORT_MAX_WINDOW_DAYS=400
# Worker: revisions rendered per page (one checkpoint per page), lease and attempts per job
EXPORT_PAGE_SIZE=200
EXPORT_JOB_LEASE_SECONDS=300
EXPORT_JOB_MAX_ATTEMPTS=3

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=debug

# =============================================
# ADDITIONAL CONFIGURATION
# =============================================
# Add any additional environment variables as needed


# Allow POST /auth/register without a token (local dev only). Production: false, create the first admin with npm run db:bootstrap-admin
AUTH_ALLOW_PUBLIC_REGISTRATION=false
